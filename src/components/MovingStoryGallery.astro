---
import { getImage } from "astro:assets";
import PhotoGallery from "./PhotoGallery.tsx";
import img1 from "../assets/images/2024/01/1704334081141-edited.jpeg";
import img2 from "../assets/images/2024/01/1704334077310-edited.jpeg";
import img3 from "../assets/images/2024/01/1704334081787-768x1024.jpeg";
import img4 from "../assets/images/2024/01/1704334082361-768x1024.jpeg";
import img5 from "../assets/images/2024/01/1704334080353-768x1024.jpeg";
import img6 from "../assets/images/2024/01/1704334080653-edited.jpeg";
import img7 from "../assets/images/2024/01/1704334083729-768x1024.jpeg";
import img8 from "../assets/images/2024/01/1704334082951-768x1024.jpeg";
import img9 from "../assets/images/2024/01/1704334082375-768x1024.jpeg";
import img10 from "../assets/images/2024/01/1704334080652-768x1024.jpeg";
import img11 from "../assets/images/2024/01/D67AEFBD-28B8-4358-B340-7FE74EF4D747_1_105_c.jpeg";
import img12 from "../assets/images/2024/01/1704334078703-768x1024.jpeg";

// Define the photos for the moving story post
const sourcePhotos = [
  {
    image: img1,
    alt: "Old office memories",
  },
  {
    image: img2,
    alt: "Office clearing out",
  },
  {
    image: img3,
    alt: "Electronics projects",
  },
  {
    image: img4,
    alt: "Office equipment",
  },
  {
    image: img5,
    alt: "Old office setup",
  },
  {
    image: img6,
    alt: "Office memories",
  },
  {
    image: img7,
    alt: "Equipment storage",
  },
  {
    image: img8,
    alt: "Old office items",
  },
  {
    image: img9,
    alt: "Office transition",
  },
  {
    image: img10,
    alt: "Moving day",
  },
  {
    image: img11,
    alt: "New office preview",
  },
  {
    image: img12,
    alt: "New office with pink stairs",
  },
];

const photos = await Promise.all(
  sourcePhotos.map(async ({ image, alt }) => {
    const widths = [...new Set([320, 640, 960, 1280, image.width])].filter(
      width => width <= image.width
    );
    const srcSet = await Promise.all(
      widths.map(async width => {
        const optimized = await getImage({ src: image, width, format: "webp" });
        return {
          src: optimized.src,
          width,
          height: Math.round((width / image.width) * image.height),
        };
      })
    );

    return {
      ...srcSet.at(-1)!,
      alt,
      srcSet,
    };
  })
);
---

<PhotoGallery photos={photos} client:load />
