---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import getPostsCacheKey from "@/utils/getPostsCacheKey";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    }).map(result => {
      const postsCacheKey = getPostsCacheKey(result.props.page.data);
      return {
        ...result,
        cacheKey:
          postsCacheKey === undefined
            ? undefined
            : `${tagName}:${result.props.page.total}:${postsCacheKey}`,
      };
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout
  title={`Tag: ${tagName} | ${SITE.title}`}
  description={`All the articles with the tag "${tagName}".`}
  schemaKind="collection"
  breadcrumbs={[
    { name: "Home", url: SITE.website },
    { name: "Tags", url: new URL("/tags", SITE.website).href },
    { name: tagName, url: new URL(`/tags/${tag}`, SITE.website).href },
    ...(page.currentPage > 1
      ? [
          {
            name: `Page ${page.currentPage}`,
            url: new URL(Astro.url.pathname, SITE.website).href,
          },
        ]
      : []),
  ]}
>
  <Header />
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
