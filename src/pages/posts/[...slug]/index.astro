---
import { type CollectionEntry, getCollection } from "astro:content";
import PostDetails from "@/layouts/PostDetails.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getPostsCacheKey from "@/utils/getPostsCacheKey";
import { getPath } from "@/utils/getPath";

export interface Props {
  post: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const sortedPosts = getSortedPosts(posts);
  const postResult = posts.map(post => {
    const postIndex = sortedPosts.findIndex(({ id }) => id === post.id);
    const relatedPosts = [
      post,
      sortedPosts[postIndex - 1],
      sortedPosts[postIndex + 1],
    ].filter(
      (relatedPost): relatedPost is CollectionEntry<"blog"> =>
        relatedPost !== undefined
    );

    return {
      params: { slug: getPath(post.id, post.filePath, false) },
      props: { post },
      cacheKey: getPostsCacheKey(relatedPosts),
    };
  });

  return postResult;
}

const { post } = Astro.props;

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);
---

<PostDetails post={post} posts={sortedPosts} />
